PORT=3001

# Opção 1 (Render): URL completa do Postgres
# DATABASE_URL=postgresql://usuario:senha@host:5432/books_db
# DB_SSL=true

# Opção 2 (local): variáveis separadas
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=books_db

# Origens liberadas no CORS (separadas por vírgula). Vazio = todas.
# CORS_ORIGIN=https://lendomais-frontend.onrender.com
